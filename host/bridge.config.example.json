  "camera": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "maxWidth": 3840,
    "maxHeight": 2160,
    "maxFps": 60,
    "friendlyName": "Mobile Webcam",
    "backend": "auto"
  },
  "logging": {
    "level": "info"
  }
}
