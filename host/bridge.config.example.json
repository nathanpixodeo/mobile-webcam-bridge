{
  "device": {
    "port": 27100
  },
  "usbmux": {
    "enabled": true
  },
  "adb": {
    "enabled": true,
    "startServer": true
  },
  "video": {
    "bitsPerPixel": 0.1,
    "camera": "back.wide",
