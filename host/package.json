{
  "name": "@mobile-webcam-bridge/host",
  "version": "0.1.0",
  "private": true,
  "description": "Windows host for Mobile Webcam Bridge: exposes an iPhone or Android phone camera and microphone as virtual Windows devices.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "os": [
    "win32"
  ],
  "bin": {
    "mobile-webcam-bridge": "./src/main.ts"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#ports/*": "./src/ports/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#cli/*": "./src/cli/*",
    "#composition/*": "./src/composition/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "bridge": "node src/main.ts",
    "start": "node src/main.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "plist": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
