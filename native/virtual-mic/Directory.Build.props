<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported automatically by virtual-mic.vcxproj. It shadows native/Directory.Build.props (MSBuild
  only imports the nearest Directory.Build.props), so nothing of the user-mode settings leaks into
  the kernel build. It runs before Microsoft.Cpp.Default.props and therefore only sets properties
  that are safe that early; output folders, compiler and linker settings live in KernelMode.props,
  which the project imports after Microsoft.Cpp.props.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    WDK/SDK from NuGet (packages.config, restored into native/packages by
    `scripts/build-native.ps1 -UseWdkNuGet`). Imported only when restored, so machines with the
    WDK installed through Visual Studio keep using it.
  -->
  <PropertyGroup>
    <MwbWdkNuGetVersion>10.0.28000.2526</MwbWdkNuGetVersion>
    <MwbPackagesDir>$(MSBuildThisFileDirectory)..\packages\</MwbPackagesDir>
  </PropertyGroup>
  <Import Project="$(MwbPackagesDir)Microsoft.Windows.WDK.x64.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(MwbPackagesDir)Microsoft.Windows.WDK.x64.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MwbPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('$(MwbPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MwbPackagesDir)Microsoft.Windows.SDK.CPP.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('$(MwbPackagesDir)Microsoft.Windows.SDK.CPP.$(MwbWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
  <!--
    With the NuGet WDK, the WDK targets set the stampinf/tracewpp/mc tool paths only when
    $(Processor_Architecture) is AMD64 or ARM64, so the build must run under the 64-bit MSBuild
    (MSBuild\Current\Bin\amd64). Under the x86 MSBuild the build fails with
    TRK0005 "Failed to locate: stampinf.exe".
  -->

  <PropertyGroup>
    <MwbNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</MwbNativeRoot>
    <!-- The kernel-mode toolset picks the newest installed WDK/SDK pair by default. -->
  </PropertyGroup>
</Project>
