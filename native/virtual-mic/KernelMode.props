<?xml version="1.0" encoding="utf-8"?>
<!--
  Compiler and linker settings of mwbmic.sys. Imported by virtual-mic.vcxproj after
  Microsoft.Cpp.props so that these values win over the toolset defaults.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Output layout (protocol/BRIDGE_NATIVE.md §4). Set here rather than in Directory.Build.props:
    the WDK's WindowsDriver.Shared.props (imported by Microsoft.Cpp.props) overrides OutDir and
    IntDir set any earlier.
      native/out/<Configuration>/x64/mwbmic.sys          build output
      native/out/<Configuration>/x64/virtual-mic/        driver package: .sys, .inf, .cat
  -->
  <PropertyGroup>
    <OutDir>$(MwbNativeRoot)out\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(MwbNativeRoot)out\obj\$(Configuration)\$(Platform)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(MwbNativeRoot)common\include;$(DDK_INC_PATH);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN32;UNICODE;_UNICODE;PC_IMPLEMENTATION;_USE_WAVERT_;_NEW_DELETE_OPERATORS_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- Kernel CFG; together with NX pool (POOL_FLAG_NON_PAGED) keeps the driver HVCI compatible. -->
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <ExceptionHandling>
      </ExceptionHandling>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)\portcls.lib;$(DDK_LIB_PATH)\stdunk.lib;$(DDK_LIB_PATH)\libcntpr.lib;$(DDK_LIB_PATH)\wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(DDK_INC_PATH);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN32;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Inf>
      <!-- DriverVer version; the date is the build date. -->
      <TimeStamp>0.1.0.0</TimeStamp>
    </Inf>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG_LEVEL=DEBUGLVL_VERBOSE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG_LEVEL=DEBUGLVL_TERSE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
