// Version resource of mwbmic.sys.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DRV
 FILESUBTYPE    VFT2_DRV_SOUND
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MobileWebcamBridge"
            VALUE "FileDescription",  "Mobile Webcam Bridge virtual microphone driver"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "mwbmic.sys"
            VALUE "LegalCopyright",   "Portions Copyright (C) Microsoft Corporation, MS-PL"
            VALUE "OriginalFilename", "mwbmic.sys"
            VALUE "ProductName",      "MobileWebcamBridge"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
