root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,hpp,c,swift}]
indent_size = 4

[*.{sln,vcxproj,filters,props,targets,rc,inf,def,bat,cmd,ps1}]
end_of_line = crlf

[*.{cpp,h,hpp,c}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
