* text=auto eol=lf

# Windows-native files keep CRLF (MSBuild, INF tooling and batch files expect it)
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.filters  text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.rc       text eol=crlf
*.inf      text eol=crlf
*.def      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

*.png  binary
*.nv12 binary
*.h264 binary
*.wav  binary
